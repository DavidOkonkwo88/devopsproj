name: Auto close issue
on:
  push:
    branches: [ main ]
jobs:
  close_issue:
    runs-on: ubuntu-latest
    steps:
      - name: Close issue on push
        uses: peter-evans/close-issue@v2
        with:
          issue-number: <bug‑issue‑number>
          comment: "Fix pushed to main – auto‑closed."
